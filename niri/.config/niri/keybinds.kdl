// ────────────── Keybindings ──────────────
// https://github.com/YaLTeR/niri/wiki/Configuration:-Key-Bindings



binds {


    Mod+Alt+Slash                      { show-hotkey-overlay; }

    // ─── Applications ───
    Mod+Space                          hotkey-overlay-title="Open Launcher: Vicinae" repeat=false { spawn "vicinae" "toggle"; }
    Mod+Return                         hotkey-overlay-title="Open Terminal: Ghostty" { spawn "ghostty"; }
    Mod+B                              hotkey-overlay-title="Open Browser: firefox" { spawn "firefox"; }
    Mod+P                              hotkey-overlay-title="Open Agent: Pi" { spawn "ghostty" "-e" "pi"; }

    // ─── Noctalia Shell Control ───

    Ctrl+Alt+Delete                    hotkey-overlay-title="Session Menu: noctalia sessionMenu" { spawn "noctalia" "msg" "panel-toggle" "session"; }
    Ctrl+Alt+Space                     hotkey-overlay-title="Open App Launcher: noctalia launcher" { spawn "noctalia" "msg" "panel-toggle" "launcher"; }

    Ctrl+Alt+W                         hotkey-overlay-title="Wallpaper Selector: noctalia wallpaper" { spawn "noctalia" "msg" "panel-toggle" "wallpaper"; }
    Ctrl+Alt+S                         hotkey-overlay-title="Noctalia Settings: noctalia settings" { spawn "noctalia" "msg" "settings-toggle"; }
    Ctrl+Alt+Return                         hotkey-overlay-title="Control Center: noctalia controlCenter" { spawn "noctalia" "msg" "panel-toggle" "control-center"; }
    Ctrl+Alt+L                         hotkey-overlay-title="Lock Screen: noctalia lockScreen" { spawn "noctalia" "msg" "session" "lock"; }

    // ─── Media Controls ───
    XF86AudioRaiseVolume               allow-when-locked=true { spawn "noctalia" "msg" "volume-up"; }
    XF86AudioLowerVolume               allow-when-locked=true { spawn "noctalia" "msg" "volume-down"; }
    XF86AudioMute                      allow-when-locked=true { spawn "noctalia" "msg" "volume-mute"; }
    XF86AudioMicMute                   allow-when-locked=true { spawn "noctalia" "msg" "volume-input-mute"; }
    XF86AudioNext                      allow-when-locked=true { spawn "noctalia" "msg" "media-next"; }
    XF86AudioPrev                      allow-when-locked=true { spawn "noctalia" "msg" "media-prev"; }
    XF86AudioPlay                      allow-when-locked=true { spawn "noctalia" "msg" "media-play-pause"; }
    XF86AudioPause                     allow-when-locked=true { spawn "noctalia" "msg" "media-play-pause"; }

    // ─── Brightness Controls ───
    XF86MonBrightnessUp                allow-when-locked=true { spawn "noctalia" "msg" "brightness-up"; }
    XF86MonBrightnessDown              allow-when-locked=true { spawn "noctalia" "msg" "brightness-down"; }

    // ─── Window Movement and Focus ───
    // Close Window
    Mod+Q                              { close-window; }

    // Focus Windows
    Mod+Left                           { focus-column-left; }
    Mod+H                              { focus-column-left; }
    Mod+Right                          { focus-column-right; }
    Mod+L                              { focus-column-right; }
    Mod+Up                             { focus-window-up; }
    Mod+K                              { focus-window-up; }
    Mod+Down                           { focus-window-down; }
    Mod+J                              { focus-window-down; }

    Mod+WheelScrollRight               { focus-column-right; }
    Mod+WheelScrollLeft                { focus-column-left; }

    Mod+Home                           { focus-column-first; }
    Mod+End                            { focus-column-last; }

    // Move Columns

    Mod+Ctrl+H                         { move-column-left; }
    Mod+Ctrl+L                         { move-column-right; }
    Mod+Ctrl+K                         { move-window-up; }
    Mod+Ctrl+J                         { move-window-down; }
    Mod+Ctrl+Left                      { move-column-left; }
    Mod+Ctrl+Right                     { move-column-right; }
    Mod+Ctrl+Up                        { move-window-up; }
    Mod+Ctrl+Down                      { move-window-down; }
    Mod+Ctrl+WheelScrollRight          { move-column-right; }
    Mod+Ctrl+WheelScrollLeft           { move-column-left; }
    Mod+Ctrl+Home                      { move-column-to-first; }
    Mod+Ctrl+End                       { move-column-to-last; }

    // Consume and expel Windows
    Mod+Ctrl+BracketLeft               { consume-or-expel-window-left; }
    Mod+Ctrl+BracketRight              { consume-or-expel-window-right; }

    //Focus Monitor
    Mod+Alt+H                     { focus-monitor-left; }
    Mod+Alt+L                     { focus-monitor-right; }
    Mod+Alt+K                     { focus-monitor-up; }
    Mod+Alt+J                     { focus-monitor-down; }
    Mod+Alt+Left                  { focus-monitor-left; }
    Mod+Alt+Right                 { focus-monitor-right; }
    Mod+Alt+UP                    { focus-monitor-up; }
    Mod+Alt+Down                  { focus-monitor-down; }
    Mod+Alt+WheelScrollLeft                  { focus-monitor-left; }
    Mod+Alt+WheelScrollRight                 { focus-monitor-right; }
    Mod+Alt+WheelScrollUP                    { focus-monitor-up; }
    Mod+Alt+WheelScrollDown                  { focus-monitor-down; }

    //Move Column to Another Monitor
    Mod+Alt+Ctrl+H                          { move-column-to-monitor-left; }
    Mod+Alt+Ctrl+L                          { move-column-to-monitor-right; }
    Mod+Alt+Ctrl+K                          { move-column-to-monitor-up; }
    Mod+Alt+Ctrl+J                          { move-column-to-monitor-down; }
    Mod+Alt+Ctrl+Left                       { move-column-to-monitor-left; }
    Mod+Alt+Ctrl+Right                      { move-column-to-monitor-right; }
    Mod+Alt+Ctrl+Up                         { move-column-to-monitor-up; }
    Mod+Alt+Ctrl+Down                       { move-column-to-monitor-down; }
    Mod+Alt+Ctrl+WheelScrollLeft            { move-column-to-monitor-left; }
    Mod+Alt+Ctrl+WheelScrollRight           { move-column-to-monitor-right; }
    Mod+Alt+Ctrl+WheelScrollUp              { move-column-to-monitor-up; }
    Mod+Alt+Ctrl+WheelScrollDown            { move-column-to-monitor-down; }

    // ─── Workspace Switching ──
    //Focus workspace
    Mod+1                              { focus-workspace 1; }
    Mod+2                              { focus-workspace 2; }
    Mod+3                              { focus-workspace 3; }
    Mod+4                              { focus-workspace 4; }
    Mod+5                              { focus-workspace 5; }
    Mod+6                              { focus-workspace 6; }
    Mod+7                              { focus-workspace 7; }
    Mod+8                              { focus-workspace 8; }
    Mod+9                              { focus-workspace 9; }

    Mod+WheelScrollDown                cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp                  cooldown-ms=150 { focus-workspace-up; }
    Mod+Page_Down                      cooldown-ms=150 { focus-workspace-down; }
    Mod+Page_Up                        cooldown-ms=150 { focus-workspace-up; }
    Mod+U                              cooldown-ms=150 { focus-workspace-down; }
    Mod+I                              cooldown-ms=150 { focus-workspace-up; }

    Mod+Tab                            { focus-workspace-previous; }

    //Move column to workspac
    Mod+Ctrl+1                         { move-column-to-workspace 1; }
    Mod+Ctrl+2                         { move-column-to-workspace 2; }
    Mod+Ctrl+3                         { move-column-to-workspace 3; }
    Mod+Ctrl+4                         { move-column-to-workspace 4; }
    Mod+Ctrl+5                         { move-column-to-workspace 5; }
    Mod+Ctrl+6                         { move-column-to-workspace 6; }
    Mod+Ctrl+7                         { move-column-to-workspace 7; }
    Mod+Ctrl+8                         { move-column-to-workspace 8; }
  
    Mod+Ctrl+WheelScrollDown           cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp             cooldown-ms=150 { move-column-to-workspace-up; }
    Mod+Ctrl+Page_Down                 cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up                   cooldown-ms=150 { move-column-to-workspace-up; }
    Mod+Ctrl+U                         cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+I                         cooldown-ms=150 { move-column-to-workspace-up; }

    // ─── Layout Controls ───
    // Resize columns
    Mod+Minus                          { set-column-width "-10%"; }
    Mod+Equal                          { set-column-width "+10%"; }
    Mod+Shift+Minus                    { set-window-height "-10%"; }
    Mod+Shift+Equal                    { set-window-height "+10%"; }

    Mod+R                              { switch-preset-column-width; }
    Mod+Shift+R                        { switch-preset-window-height; }

    Mod+E                              { set-column-width "50.000000000000000%"; }
    Mod+T                              { set-column-width "33.333333333333333%"; }
    Mod+F                              { maximize-column; }
    Mod+Shift+F                        { fullscreen-window; }
    Mod+Alt+F                          { expand-column-to-available-width; }

    // Workspace focus
    Mod+C                              { center-column; }
    Mod+Shift+C                        { center-visible-columns; }

    Mod+O                              repeat=false { toggle-overview; }
    Mod+W                              repeat=false { toggle-overview; }

    Mod+V                              { toggle-window-floating; }
    Mod+Alt+V                          { switch-focus-between-floating-and-tiling; }

    // ─── Misc ───
    // Screenshots
    Mod+Shift+2                        { screenshot-window; }   //active window only
    Mod+Shift+3                        { screenshot-screen; }   //entire screen
    Mod+Shift+4                        { screenshot; }          //screenshot area

    // Emergency Escape Key 
    // Use this when a fullscreen app blocks your keybinds.
    // It disables any active keyboard shortcut inhibitor, restoring control.
    Mod+ESCAPE                         allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }

    //  Exit / Power 
    Mod+Shift+P                        { power-off-monitors; } // Turn off screens (useful for OLED or privacy)
    
}
