// ────────────── Startup Applications ──────────────
// https://github.com/YaLTeR/niri/wiki/Configuration:-Miscellaneous#spawn-sh-at-startup

spawn-at-startup "noctalia" "--daemon"
spawn-sh-at-startup "vicinae server"
spawn-sh-at-startup "1password --silent"
spawn-sh-at-startup "pidof tailscale > /dev/null || tailscale systray"
